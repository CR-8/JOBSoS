# =============================================================================
# CareerHub - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values before running:
#   docker compose up -d
# =============================================================================

# --- Domain ---
# Public domain where CareerHub will be served (no trailing slash).
DOMAIN=careerhub.local

# Public-facing URL (used for OAuth callbacks and links).
APP_URL=https://${DOMAIN}

# --- PostgreSQL (shared) ---
POSTGRES_USER=careerhub
POSTGRES_PASSWORD=changeme-postgres-password

# --- Reactive Resume ---
# Generated using: openssl rand -hex 32
RR_AUTH_SECRET=change-me-rr-auth-secret-at-least-32-chars
# Generated using: openssl rand -hex 32
RR_ENCRYPTION_SECRET=change-me-rr-encryption-secret-at-least-32-chars
# Disable signups after first user is created (recommended for personal use)
RR_DISABLE_SIGNUPS=true

# --- Authentik (SSO) ---
# Version of authentik to use (see https://goauthentik.io/docs/releases/)
AUTHENTIK_VERSION=2025.6
# Generated using: openssl rand -hex 32
AUTHENTIK_SECRET_KEY=change-me-authentik-secret-key
# Bootstrap credentials for initial admin login
AUTHENTIK_BOOTSTRAP_PASSWORD=changeme-admin-password
AUTHENTIK_BOOTSTRAP_EMAIL=admin@careerhub.local
# Bootstrap token for API access (generate with: openssl rand -hex 24)
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-authentik-bootstrap-token

# --- OIDC Client IDs ---
# These are configured in Authentik after first setup.
# See README for step-by-step OIDC application creation.
RR_OIDC_CLIENT_ID=reactive-resume
RR_OIDC_CLIENT_SECRET=change-me-rr-oidc-secret
DASHBOARD_OIDC_CLIENT_ID=dashboard
DASHBOARD_OIDC_CLIENT_SECRET=change-me-dashboard-oidc-secret

# OIDC Discovery URL (pointed at Authentik)
# For Traefik deployment (docker-compose.yml): uses /auth path
#   OAUTH_DISCOVERY_URL=https://${DOMAIN}/auth/application/o/careerhub/.well-known/openid-configuration
# For Coolify deployment (docker-compose.coolify.yml): use auth subdomain
#   OAUTH_DISCOVERY_URL=https://auth.${DOMAIN}/application/o/careerhub/.well-known/openid-configuration
OAUTH_PROVIDER_NAME=CareerHub SSO
OAUTH_DISCOVERY_URL=https://${DOMAIN}/auth/application/o/careerhub/.well-known/openid-configuration

# --- JobOps ---
# Basic auth credentials for JobOps access (no native OIDC support).
JOBOPS_AUTH_USER=admin
JOBOPS_AUTH_PASSWORD=changeme-jobops-password

# RxResume API key for JobOps integration (if required by your version).
RXRESUME_API_KEY=

# --- Resume Sync API ---
# JWT secret for sync API tokens (generate with: openssl rand -hex 32)
SYNC_JWT_SECRET=change-me-sync-jwt-secret
# API key to authenticate calls to Reactive Resume API (if required).
RR_SYNC_API_KEY=

# --- Storage ---
# SeaweedFS credentials (defaults are fine for local deployments).
S3_ACCESS_KEY_ID=seaweedfs
S3_SECRET_ACCESS_KEY=seaweedfs
S3_REGION=us-east-1

# --- Traefik / ACME ---
# Email for Let's Encrypt certificate notifications.
ACME_EMAIL=admin@careerhub.local
TRAEFIK_LOG_LEVEL=INFO

# --- General ---
LOG_LEVEL=INFO
